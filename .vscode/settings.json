{
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss",
    "static.yml": "plaintext",
    "**/.github/workflows/*.yml": "plaintext",
    "**/.github/workflows/*.yaml": "plaintext"
  },
  "yaml.validate": false,
  "yaml.schemaStore.enable": false,
  "github-actions.workflows.pinnedVersionWarning": false
}
